---
import BaseLayout from './BaseLayout.astro';
import { getEntry, render, type CollectionEntry } from 'astro:content';
import { categories } from '../lib/taxonomy';
import { dateLabel } from '../lib/site';
import ArticleExtras from '../components/ArticleExtras.astro';
import { readingMinutes } from '../lib/reading';
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
const projects = await Promise.all(
  data.relatedProjectIds.map((p) => getEntry(p)),
);
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  noindex={data.draft}
  article={data}
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/writing/">Writing</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{categories[data.category].label}</span>
    </nav>
    <article class="reading" data-category={data.category}>
      <header class="page-head">
        {data.draft && (
          <p class="draft-banner">
            Review draft · Not published · Awaiting author approval
          </p>
        )}
        <p class="eyebrow">
          {categories[data.category].label} / {data.format.replace('-', ' ')}
        </p>
        <h1>{data.title}</h1>
        <p class="lede">{data.description}</p>
        <div class="article-meta">
          <span>By Muhammad Ekramah</span>
          <span
            aria-label={`Estimated reading time: ${readingMinutes(article.body)} minutes`}
          >
            {readingMinutes(article.body)} min read
          </span>
          {data.publishedAt && (
            <time datetime={data.publishedAt.toISOString()}>
              {dateLabel(data.publishedAt)}
            </time>
          )}
          {data.updatedAt && <span>Updated {dateLabel(data.updatedAt)}</span>}
        </div>
      </header>
      {headings.filter((h) => h.depth === 2).length > 2 && (
        <details class="toc">
          <summary>In this note</summary>
          <ul>
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
          </ul>
        </details>
      )}
      <div class="prose">
        <Content />
      </div>
      {data.references.length > 0 && (
        <section class="evidence">
          <h2>Sources & further inspection</h2>
          <ul>
            {data.references.map((ref) => (
              <li>
                <a href={ref.url}>{ref.label} ↗</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {projects.length > 0 && (
        <section class="evidence">
          <h2>Related work</h2>
          <ul>
            {projects.map(
              (p) =>
                p && (
                  <li>
                    <a href={`/portfolio/${p.id}/`}>{p.data.shortTitle} →</a>
                  </li>
                ),
            )}
          </ul>
        </section>
      )}
      <ArticleExtras article={article} />
      <a class="text-link" href="/writing/">
        ← Back to writing
      </a>
    </article>
  </div>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;
    const toolbar = document.createElement('div');
    toolbar.className = 'code-toolbar';
    const language = document.createElement('span');
    language.textContent =
      code.className.match(/language-([\w-]+)/)?.[1] || 'Code';
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.textContent = 'Copy code';
    const status = document.createElement('span');
    status.setAttribute('role', 'status');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent || '');
        status.textContent = 'Code copied.';
      } catch {
        status.textContent = 'Copy unavailable. Select the code to copy it.';
      }
    });
    toolbar.append(language, status, button);
    pre.before(toolbar);
  });
</script>
