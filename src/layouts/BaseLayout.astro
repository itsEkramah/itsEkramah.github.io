---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import '../styles/global.css';
import StructuredData from '../components/StructuredData.astro';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  article?: { publishedAt?: Date; updatedAt?: Date; draft: boolean };
}
const { title, description, noindex = false, article } = Astro.props;
const canonical = new URL(
  Astro.url.pathname === '/404/'
    ? '/404.html'
    : Astro.url.pathname.replace(/^\/work\//, '/portfolio/'),
  site.url,
);
const isAbout = Astro.url.pathname === '/about/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Muhammad Ekramah</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex ||
      ['review', 'demo'].includes(import.meta.env.MODE) ||
      Astro.url.pathname.startsWith('/work/')) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <meta name="theme-color" content="#F7F5EF" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:title" content={`${title} | Muhammad Ekramah`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article?.publishedAt && (
      <meta
        property="article:published_time"
        content={article.publishedAt.toISOString()}
      />
    )}
    {article?.updatedAt && (
      <meta
        property="article:modified_time"
        content={article.updatedAt.toISOString()}
      />
    )}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social.png', site.url)} />
    <meta
      property="og:image:alt"
      content="Muhammad Ekramah — Bioinformatics, Data, Research software"
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Muhammad Ekramah — Writing"
      href="/feed.xml"
    />
    {article && !article.draft && (
      <StructuredData
        value={{
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: title,
          description,
          url: canonical.href,
          mainEntityOfPage: canonical.href,
          datePublished: article.publishedAt?.toISOString(),
          dateModified: (
            article.updatedAt || article.publishedAt
          )?.toISOString(),
          author: {
            '@type': 'Person',
            name: site.name,
            url: `${site.url}/about/`,
          },
        }}
      />
    )}
    {isAbout && (
      <StructuredData
        value={{
          '@context': 'https://schema.org',
          '@type': 'ProfilePage',
          url: `${site.url}/about/`,
          mainEntity: {
            '@type': 'Person',
            name: site.name,
            url: site.url,
            sameAs: [site.github, site.linkedin],
            alumniOf: {
              '@type': 'CollegeOrUniversity',
              name: 'Quaid-i-Azam University',
            },
          },
        }}
      />
    )}
  </head>
  <body>
    {['review', 'demo'].includes(import.meta.env.MODE) && (
      <div class="preview-notice">
        <p class="wrap">
          Site preview · Publication status is shown on each article.
          Unpublished drafts remain excluded from the production website.
        </p>
      </div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
