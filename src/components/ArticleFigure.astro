---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  credit: string;
}
const { src, alt, caption, credit } = Astro.props;
if (!alt.trim() || !caption.trim() || !credit.trim())
  throw new Error(
    'Scientific figures need alt text, a caption and source/permission credit',
  );
---

<figure class="figure-detail">
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1400]}
    sizes="(max-width: 700px) 90vw, 690px"
    format="webp"
    loading="lazy"
  />
  <figcaption>
    {caption} <span>{credit}</span>
  </figcaption>
</figure>
