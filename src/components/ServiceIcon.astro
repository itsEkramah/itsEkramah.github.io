---
interface Props {
  kind: number;
}
const { kind } = Astro.props;
---

<svg
  width="28"
  height="28"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {kind === 1 && (
    <>
      <path d="M4 5h6v7h6m-6 0v7h6" />
      <circle cx="18" cy="12" r="2" />
      <circle cx="18" cy="19" r="2" />
      <circle cx="4" cy="5" r="2" />
    </>
  )}
  {kind === 2 && (
    <>
      <path d="M3 20h18M5 16V9h3v7M11 16V4h3v12M17 16v-5h3v5" />
    </>
  )}
  {kind === 3 && (
    <>
      <path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-14-2 16" />
    </>
  )}
  {kind === 4 && (
    <>
      <rect x="2" y="4" width="20" height="15" rx="1" />
      <path d="M2 8h20m-14 14h8m-4-3v3" />
    </>
  )}
  {kind === 5 && (
    <>
      <circle cx="10" cy="10" r="7" />
      <path d="m15 15 7 7M7 10h6m-6 3h3m-3-6h4" />
    </>
  )}
</svg>
