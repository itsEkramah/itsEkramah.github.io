---
import type { CollectionEntry } from 'astro:content';
import { categories } from '../lib/taxonomy';
import { articleUrl, dateLabel } from '../lib/site';
import { readingMinutes } from '../lib/reading';
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const minutes = readingMinutes(article.body);
---

<article class="featured-article" data-category={article.data.category}>
  <p class="eyebrow">{categories[article.data.category].label}</p>
  <h3>
    <a href={articleUrl(article)}>{article.data.title}</a>
  </h3>
  <p class="article-summary">{article.data.description}</p>
  <div class="article-card-footer">
    <span>
      {article.data.draft
        ? 'Demo draft · Not published'
        : article.data.publishedAt && (
            <time datetime={article.data.publishedAt.toISOString()}>
              {dateLabel(article.data.publishedAt)}
            </time>
          )}
    </span>
    <span aria-label={`Estimated reading time: ${minutes} minutes`}>
      {minutes} min read
    </span>
  </div>
  <a class="text-link" href={articleUrl(article)}>
    {article.data.draft ? 'Read demo article' : 'Read article'}{' '}
    <span aria-hidden="true">→</span>
  </a>
</article>
