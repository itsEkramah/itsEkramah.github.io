---
import type { CollectionEntry } from 'astro:content';
import { articleUrl, dateLabel } from '../lib/site';
import { categories } from '../lib/taxonomy';
import { readingMinutes } from '../lib/reading';
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
---

<article
  class="article-entry"
  data-article
  data-category={article.data.category}
  data-search={`${article.data.title} ${article.data.description} ${article.data.tags.join(' ')}`.toLowerCase()}
>
  <p class="eyebrow">
    {categories[article.data.category].label} ·{' '}
    {article.data.format.replace('-', ' ')}
  </p>
  <h2>
    <a href={articleUrl(article)}>
      {article.data.title} <span aria-hidden="true">→</span>
    </a>
  </h2>
  <p>{article.data.description}</p>
  <ul class="tags" aria-label="Tags">
    {article.data.tags.map((tag) => (
      <li>{tag}</li>
    ))}
  </ul>
  {article.data.draft && <p class="draft-label">Unpublished draft</p>}
  {article.data.publishedAt && (
    <time datetime={article.data.publishedAt.toISOString()}>
      {dateLabel(article.data.publishedAt)}
    </time>
  )}
  <span
    class="reading-estimate"
    aria-label={`Estimated reading time: ${readingMinutes(article.body)} minutes`}
  >
    {readingMinutes(article.body)} min read
  </span>
</article>
<style>
  .reading-estimate {
    display: inline-block;
    margin-left: 16px;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
