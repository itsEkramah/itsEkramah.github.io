---
import { site } from '../lib/site';
const path = Astro.url.pathname;
const links = [
  ['Work', '/work/'],
  ['Services', '/services/'],
  ['Writing', '/writing/'],
  ['About', '/about/'],
  ['Contact', '/contact/'],
];
---

<a class="skip" href="#main" tabindex="0">
  Skip to content
</a>
<header class="site-header wrap">
  <a class="wordmark" href="/" aria-label="Muhammad Ekramah — home">
    Ekramah<span aria-hidden="true">.</span>
  </a>
  <nav aria-label="Main navigation">
    {links.map(([label, href]) => (
      <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
        {label}
      </a>
    ))}
    <a href={site.cv} class="nav-cv">
      CV <span class="tiny">PDF ↗</span>
    </a>
    <a href={site.github} class="nav-github">
      GitHub <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
