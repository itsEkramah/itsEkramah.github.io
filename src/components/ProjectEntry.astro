---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
interface Props {
  project: CollectionEntry<'projects'>;
  compact?: boolean;
  priority?: boolean;
  detailed?: boolean;
}
const {
  project,
  compact = false,
  priority = false,
  detailed = false,
} = Astro.props;
const { data, id } = project;
---

<article class:list={['project-entry', { compact }]}>
  {!compact && data.image && (
    <figure class="project-figure">
      <Image
        src={data.image}
        alt={data.imageAlt || ''}
        widths={[480, 800, 1200]}
        sizes="(max-width: 700px) 92vw, 560px"
        format="webp"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
      {data.imageCaption && <figcaption>{data.imageCaption}</figcaption>}
    </figure>
  )}
  <div class="project-copy">
    <p class="eyebrow">
      {data.kind}
      {data.period && ` · ${data.period}`}
    </p>
    <h3>
      <a href={`/portfolio/${id}/`}>
        {data.shortTitle} <span aria-hidden="true">↗</span>
      </a>
    </h3>
    <p>{data.summary}</p>
    <p class="tools">{data.tools.join(' / ')}</p>
    {detailed && (
      <dl class="project-facts">
        <div>
          <dt>Methods</dt>
          <dd>{data.methods.join('; ')}.</dd>
        </div>
        <div>
          <dt>Results</dt>
          <dd>{data.resultSummary}</dd>
        </div>
        <div>
          <dt>Limitations</dt>
          <dd>{data.limitations}</dd>
        </div>
      </dl>
    )}
    <div class="actions project-actions">
      <a class="text-link" href={`/portfolio/${id}/`}>
        Read case study <span aria-hidden="true">→</span>
      </a>
      <a class="text-link" href={data.repoUrl}>
        GitHub ↗
      </a>
      {data.demoUrl && (
        <a class="text-link" href={data.demoUrl}>
          Video demo ↗
        </a>
      )}
    </div>
  </div>
</article>
