---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
interface Props {
  project: CollectionEntry<'projects'>;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const { data, id } = project;
---

<article class:list={['project-entry', { compact }]}>
  {!compact && data.image && (
    <a
      href={`/portfolio/${id}/`}
      class="project-figure"
      tabindex="-1"
      aria-hidden="true"
    >
      <Image
        src={data.image}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(max-width: 700px) 92vw, 560px"
        format="webp"
        loading="lazy"
      />
    </a>
  )}
  <div class="project-copy">
    <p class="eyebrow">
      {data.kind}
      {data.period && ` · ${data.period}`}
    </p>
    <h3>
      <a href={`/portfolio/${id}/`}>
        {data.shortTitle} <span aria-hidden="true">↗</span>
      </a>
    </h3>
    <p>{data.summary}</p>
    <p class="tools">{data.tools.join(' / ')}</p>
    <a class="text-link" href={`/portfolio/${id}/`}>
      Read case study <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
