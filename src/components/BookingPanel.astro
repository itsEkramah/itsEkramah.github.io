---
import { site } from '../lib/site';
---

<section
  class="section consultation"
  id="booking"
  aria-labelledby="booking-title"
  data-booking
  data-booking-url={site.booking}
>
  <div class="consultation-intro">
    <div>
      <p class="eyebrow">A first conversation</p>
      <h2 id="booking-title">{`A free ${site.callMinutes}-minute discussion.`}</h2>
    </div>
    <div>
      <p>
        Bring a research, data or development question. We’ll discuss the issue,
        outline a possible approach and decide on useful next steps.
      </p>
      <p class="booking-privacy">
        Opening the calendar connects to Calendly and its providers, which may
        use cookies and analytics. Booking details go to Calendly. Keep patient
        data and confidential material out of booking notes.
      </p>
      <div class="actions">
        <button
          class="button"
          type="button"
          data-booking-open
          aria-expanded="false"
          aria-controls="booking-calendar"
          hidden
        >
          Show booking calendar
        </button>
        <button
          class="button secondary"
          type="button"
          data-booking-close
          hidden
        >
          Close calendar
        </button>
        <a class="text-link" href={site.booking}>
          Open on Calendly <span aria-hidden="true">↗</span>
        </a>
      </div>
      <noscript>
        <p>
          Use the Calendly link to choose a time. The inline calendar needs
          JavaScript.
        </p>
      </noscript>
      <p class="booking-status" role="status" data-booking-status></p>
    </div>
  </div>
  <div
    class="booking-calendar"
    id="booking-calendar"
    data-booking-frame
    hidden
  ></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-booking]').forEach((panel) => {
    const open = panel.querySelector<HTMLButtonElement>('[data-booking-open]');
    const close = panel.querySelector<HTMLButtonElement>(
      '[data-booking-close]',
    );
    const holder = panel.querySelector<HTMLElement>('[data-booking-frame]');
    const status = panel.querySelector<HTMLElement>('[data-booking-status]');
    if (!open || !close || !holder || !status) return;
    const url = new URL(panel.dataset.bookingUrl || '');
    if (url.origin !== 'https://calendly.com') return;
    url.searchParams.set('hide_event_type_details', '1');
    // Keep Calendly's own cookie choices; do not load vendor code in the parent.
    url.searchParams.set('embed_type', 'Inline');
    open.hidden = false;
    open.addEventListener('click', () => {
      if (holder.querySelector('iframe')) return;
      const frame = document.createElement('iframe');
      frame.src = url.href;
      frame.title = 'Book a free consultation with Muhammad Ekramah';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.setAttribute(
        'sandbox',
        'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox',
      );
      frame.addEventListener(
        'load',
        () => {
          status.textContent =
            'Calendar opened. If it does not appear, use Open on Calendly.';
        },
        { once: true },
      );
      holder.append(frame);
      holder.hidden = false;
      open.setAttribute('aria-expanded', 'true');
      open.hidden = true;
      close.hidden = false;
      status.textContent = 'Loading the Calendly calendar…';
      close.focus();
    });
    close.addEventListener('click', () => {
      holder.replaceChildren();
      holder.hidden = true;
      close.hidden = true;
      open.hidden = false;
      open.setAttribute('aria-expanded', 'false');
      status.textContent = 'Calendar closed.';
      open.focus();
    });
  });
</script>
