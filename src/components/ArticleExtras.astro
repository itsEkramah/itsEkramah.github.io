---
import type { CollectionEntry } from 'astro:content';
import { articleUrl } from '../lib/site';
import { visibleArticles, reviewMode } from '../lib/content';
import { relatedArticles } from '../lib/related';
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const articles = await visibleArticles();
const matched = relatedArticles(article, articles, reviewMode);
const related = matched.length
  ? matched
  : articles.filter((a) => a.id !== article.id && !a.data.draft).slice(0, 3);
---

<ul class="tags" aria-label="Article tags">
  {article.data.tags.map((tag) => (
    <li>{tag}</li>
  ))}
</ul>
{related.length > 0 && (
  <section class="evidence">
    <h2>{matched.length ? 'Related reading' : 'More from the library'}</h2>
    <ul>
      {related.map((a) => (
        <li>
          <a href={articleUrl(a)}>{a.data.title} →</a>
        </li>
      ))}
    </ul>
  </section>
)}
