---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import ArticleEntry from '../components/ArticleEntry.astro';
import { getCollection } from 'astro:content';
import { categories } from '../lib/taxonomy';
import { site } from '../lib/site';
const projects = (
  await getCollection('projects', ({ data }) => data.featured)
).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => +b.data.publishedAt! - +a.data.publishedAt!);
---

<BaseLayout
  title="Bioinformatics, data & research software"
  description="Muhammad Ekramah is a bioinformatics graduate working with biological data, reproducible analysis and practical Python development. Explore projects, services and writing."
>
  <div class="wrap">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-topline">
        <p class="eyebrow">Muhammad Ekramah / Bioinformatics graduate</p>
        <span class="location">Quaid-i-Azam University, Islamabad</span>
      </div>
      <h1 id="intro-title">
        Biological questions.
        <br />
        <em>Computational thinking.</em>
      </h1>
      <div class="hero-bottom">
        <p class="hero-intro">
          I work with biological data and build practical tools for reproducible
          analysis. My focus is genomics, careful evaluation and clear, usable
          software.
        </p>
        <div class="actions">
          <a class="button" href="/work/">
            View Portfolio <span aria-hidden="true">→</span>
          </a>
          <a class="button secondary" href="/services/">
            Explore Services <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="quick-links">
        <a href="/writing/">Read Writing →</a>
        <a href={site.cv}>
          Download CV <span class="tiny">PDF ↗</span>
        </a>
        <a href="/about/#experience">Experience →</a>
        <a href={site.github}>GitHub ↗</a>
      </div>
    </section>
    <section class="section" aria-labelledby="selected-work">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / Selected work</p>
          <h2 id="selected-work">From data to defensible evidence.</h2>
        </div>
        <a class="text-link" href="/work/">
          All projects →
        </a>
      </div>
      <div class="project-grid">
        {projects.slice(0, 2).map((project) => (
          <ProjectEntry project={project} />
        ))}
      </div>
      <div class="featured-third">
        <ProjectEntry project={projects[2]} compact />
        <aside class="project-note">
          <h3>Methods, code and caveats.</h3>
          <p>
            Each case study links to the actual work and explains its limits.
            Coursework, team prototypes and software demonstrations are
            identified separately.
          </p>
        </aside>
      </div>
    </section>
    <section class="section" aria-labelledby="services-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / Working together</p>
          <h2 id="services-title">A defined task. A useful deliverable.</h2>
        </div>
        <a class="text-link" href="/services/">
          Services & scope →
        </a>
      </div>
      <div class="service-grid">
        {services.map((service, i) => (
          <article class="service-summary">
            <span class="number">0{i + 1}</span>
            <div>
              <h3>
                <a href={`/services/${service.id}/`}>{service.data.title}</a>
              </h3>
              <p>{service.data.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="section" aria-labelledby="writing-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / Writing</p>
          <h2 id="writing-title">Notes worth keeping.</h2>
        </div>
        <a class="text-link" href="/writing/">
          Writing library →
        </a>
      </div>
      {articles.length ? (
        articles
          .slice(0, 3)
          .map((article) => <ArticleEntry article={article} />)
      ) : (
        <div class="writing-summary">
          <div>
            <p>
              A place for practical methods, research notes and lessons from
              building things.
            </p>
            <p>
              No articles published yet. For now, the{' '}
              <a href="/work/">project case studies</a> contain the methods,
              evidence and limitations behind my work.
            </p>
          </div>
          <ul class="topic-list">
            {Object.values(categories).map((category) => (
              <li>{category.label}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
    <section class="section background-grid" aria-labelledby="background-title">
      <div>
        <p class="eyebrow">04 / Background</p>
        <h2 id="background-title">
          Biology meets a practical computing foundation.
        </h2>
        <p>
          I studied Bioinformatics at Quaid-i-Azam University. My interests
          include microbial genomics, transcriptomics and evaluating how well
          models transfer to new data.
        </p>
        <a class="text-link" href="/about/">
          About & experience →
        </a>
      </div>
      <ol class="timeline">
        <li>
          <span class="period">2022–2026</span>
          <div>
            <h3>BS in Bioinformatics</h3>
            <p>Quaid-i-Azam University · CGPA 3.40 / 4.00</p>
          </div>
        </li>
        <li>
          <span class="period">Jul–Aug 2025</span>
          <div>
            <h3>Research Intern</h3>
            <p>National Institutes of Health, Islamabad</p>
          </div>
        </li>
        <li>
          <span class="period">Jul–Sep 2024</span>
          <div>
            <h3>Python Developer Intern</h3>
            <p>Digital Empowerment Network · Remote</p>
          </div>
        </li>
      </ol>
    </section>
    <section class="section contact-band" aria-labelledby="contact-title">
      <div>
        <p class="eyebrow">05 / Contact</p>
        <h2 id="contact-title">Have a question to work on?</h2>
        <p>
          For research opportunities, graduate study or a scoped data and
          software project, start with the question and the output you need.
        </p>
      </div>
      <div class="actions">
        <a class="button" href="/contact/">
          Get in touch →
        </a>
        <a class="text-link" href={site.linkedin}>
          LinkedIn ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
