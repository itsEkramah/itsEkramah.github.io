---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import ResearchEvidence from '../components/ResearchEvidence.astro';
import EmailLink from '../components/EmailLink.astro';
import BookingLink from '../components/BookingLink.astro';
import { getCollection } from 'astro:content';
import { featuredArticles } from '../lib/content';
import { categories } from '../lib/taxonomy';
import { site } from '../lib/site';
import { profile } from '../data/profile';
import '../styles/home.css';
const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const articles = await featuredArticles();
---

<BaseLayout
  title="Bioinformatics, data & software development"
  description="Muhammad Ekramah's work in bioinformatics, data analysis and Python software. Explore the portfolio, scoped professional services and technical writing."
>
  <div class="wrap editorial-home">
    <section class="intro-editorial" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="eyebrow">Genomics · Data analysis · Software</p>
        <h1 id="intro-title">
          Bioinformatics &<br />
          software development.
        </h1>
        <p class="intro-description">{profile.homeSummary}</p>
        <div class="actions">
          <a class="button" href="/portfolio/">
            Explore Portfolio <span aria-hidden="true">→</span>
          </a>
          <a class="button secondary" href="/services/">
            View Services <span aria-hidden="true">→</span>
          </a>
          <a class="button secondary" href="/writing/">
            Read Articles <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="intro-links">
          <a href={site.cv}>Download CV · PDF ↗</a>
          <a href="/portfolio/#experience">Experience →</a>
          <a href={site.github}>GitHub ↗</a>
        </div>
      </div>
      <ResearchEvidence />
    </section>
    <section class="home-section" aria-labelledby="featured-writing">
      <div class="editorial-section-head">
        <div>
          <p class="eyebrow">The notebook</p>
          <h2 id="featured-writing">Writing from the work.</h2>
        </div>
        <a class="text-link" href="/writing/">
          View All Articles →
        </a>
      </div>
      {articles.length ? (
        <>
          {articles.some((article) => article.data.draft) && (
            <p class="demo-context">
              Demonstration drafts for design review. These articles are
              unpublished and have no publication dates.
            </p>
          )}
          <div class="featured-articles">
            {articles.map((article) => (
              <FeaturedArticle article={article} />
            ))}
          </div>
        </>
      ) : (
        <div class="writing-launch">
          <p>
            No articles published yet. The library is ready for completed,
            reviewed writing. For methods and evidence now, explore the{' '}
            <a href="/portfolio/">portfolio case studies</a>.
          </p>
          <ul class="writing-topics-inline">
            {Object.values(categories).map((category) => (
              <li>{category.label}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
    <section class="home-section" aria-labelledby="services-title">
      <div class="editorial-section-head">
        <div>
          <p class="eyebrow">Work together</p>
          <h2 id="services-title">What I can help with.</h2>
        </div>
        <a class="text-link" href="/services/">
          View All Services →
        </a>
      </div>
      <div class="five-services">
        {services.map((service, index) => (
          <article class="service-tile">
            <ServiceIcon kind={index + 1} />
            <h3>
              <a href={`/services/${service.id}/`}>{service.data.title}</a>
            </h3>
            <p>{service.data.summary}</p>
            <a class="service-scope" href={`/services/${service.id}/`}>
              View service <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="home-section" aria-labelledby="selected-work">
      <div class="editorial-section-head">
        <div>
          <p class="eyebrow">Selected research</p>
          <h2 id="selected-work">Two questions I’ve explored.</h2>
        </div>
        <a class="text-link" href="/portfolio/">
          View Full Portfolio →
        </a>
      </div>
      <div class="compact-work">
        {projects.map((project) => (
          <article>
            <p class="eyebrow">
              {project.data.kind} · {project.data.period}
            </p>
            <h3>
              <a href={`/portfolio/${project.id}/`}>
                {project.data.shortTitle} <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{project.data.resultSummary}</p>
            <a class="text-link" href={`/portfolio/${project.id}/`}>
              Methods, results & limitations →
            </a>
          </article>
        ))}
      </div>
    </section>
    <section
      class="home-section home-background"
      aria-labelledby="background-title"
    >
      <div>
        <p class="eyebrow">Education & experience</p>
        <h2 id="background-title">Where this work began.</h2>
        <p class="next-step">
          My next step is postgraduate study in bioinformatics and data science.
        </p>
        <a class="text-link" href="/portfolio/#education">
          Education & experience →
        </a>
      </div>
      <ol class="timeline">
        <li>
          <span class="period">{profile.education.shortPeriod}</span>
          <div>
            <h3>{profile.education.degree}</h3>
            <p>
              <a href={profile.education.institutionUrl}>
                {profile.education.institution}
              </a>{' '}
              · CGPA {profile.education.cgpa}
            </p>
          </div>
        </li>
        {profile.experience.map((entry) => (
          <li>
            <span class="period">{entry.period}</span>
            <div>
              <h3>{entry.position}</h3>
              <p>
                {entry.website ? (
                  <a href={entry.website}>
                    {entry.organization} · {entry.location}
                  </a>
                ) : (
                  <>
                    {entry.organization} · {entry.location}
                  </>
                )}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
    <section class="home-section home-contact" aria-labelledby="contact-title">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">What are you working on?</h2>
        <p>
          For research opportunities or a defined data and software task, start
          with the question and the output you need.
        </p>
      </div>
      <div>
        <EmailLink />
        <div class="actions">
          <a class="text-link" href="/contact/">
            Contact & project enquiries →
          </a>
          <a class="text-link" href={site.linkedin}>
            LinkedIn ↗
          </a>
          <BookingLink />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
