---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectEntry from '../../components/ProjectEntry.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import ResearchEvidence from '../../components/ResearchEvidence.astro';
import EmailLink from '../../components/EmailLink.astro';
import { getCollection } from 'astro:content';
import { site } from '../../lib/site';
import { profile } from '../../data/profile';
import '../../styles/destinations.css';
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const principal = projects.filter(
  (p) => p.data.kind !== 'Software demonstration',
);
const additional = projects.filter(
  (p) => p.data.kind === 'Software demonstration',
);
const { education } = profile;
---

<BaseLayout
  title="Portfolio & résumé"
  description="Muhammad Ekramah's bioinformatics education, internships, technical skills and research projects, with original analysis figures, CV and source code."
>
  <div class="wrap portfolio-page">
    <header class="page-head destination-head portfolio-opening">
      <div>
        <p class="eyebrow">
          Portfolio / Professional background & selected work
        </p>
        <h1>{profile.name}</h1>
        <p class="qualification">{profile.qualification}</p>
        <p class="lede">{profile.portfolioSummary}</p>
        <div class="actions professional-links">
          <a class="button" href={site.cv}>
            Download CV · PDF ↗
          </a>
          <a class="text-link" href={site.github}>
            GitHub ↗
          </a>
          <a class="text-link" href={site.linkedin}>
            LinkedIn ↗
          </a>
          <a class="text-link" href="/contact/">
            Contact →
          </a>
        </div>
        <p class="portfolio-directions">
          <a href="#projects">Genomic AMR · RNA-seq · PathoScope</a>
          <span>Methods, results and my contribution ↓</span>
        </p>
      </div>
      <ResearchEvidence />
    </header>
    <nav class="section-nav" aria-label="Portfolio sections">
      <a href="#education">Education</a>
      <a href="#experience">Experience</a>
      <a href="#skills">Technical Skills</a>
      <a href="#projects">Selected Projects</a>
      <a href="#additional-work">Additional Work</a>
      <a href="#professional-contact">Contact</a>
    </nav>
    <section
      class="portfolio-section"
      id="education"
      aria-labelledby="education-title"
    >
      <h2 id="education-title">Education</h2>
      <div class="education-record">
        <div>
          <h3>{education.degree}</h3>
          <p>
            <a href={education.institutionUrl}>{education.institution}</a>
            <br />
            <a href={education.centreUrl}>{education.centre}</a>
          </p>
        </div>
        <div>
          <p>{education.shortPeriod}</p>
          <p>
            <strong>CGPA:</strong> {education.cgpa}
          </p>
        </div>
      </div>
      <details class="coursework">
        <summary>Relevant coursework</summary>
        <p>
          <strong>Relevant coursework:</strong>{' '}
          {education.coursework.join('; ')}.
        </p>
      </details>
    </section>
    <section
      class="portfolio-section"
      id="experience"
      aria-labelledby="experience-title"
    >
      <h2 id="experience-title">Professional Experience</h2>
      <ExperienceTimeline />
    </section>
    <section
      class="portfolio-section"
      id="skills"
      aria-labelledby="skills-title"
    >
      <h2 id="skills-title">Technical Skills</h2>
      <dl class="skills professional-skills">
        {profile.skills.map((skill) => (
          <div>
            <dt>{skill.category}</dt>
            <dd>{skill.items}</dd>
          </div>
        ))}
      </dl>
    </section>
    <section
      class="portfolio-section"
      id="projects"
      aria-labelledby="projects-title"
    >
      <h2 id="projects-title">
        <span id="academic-title">Selected Projects</span>
      </h2>
      <p class="section-intro">
        Academic research and team development, with methods, results and source
        code.
      </p>
      <div class="work-list portfolio-projects">
        {principal.map((project) => (
          <ProjectEntry
            project={project}
            compact={!project.data.image}
            detailed
          />
        ))}
      </div>
    </section>
    <section
      class="portfolio-section"
      id="additional-work"
      aria-labelledby="additional-title"
    >
      <h2 id="additional-title">Additional Work</h2>
      <h3 id="software-title">Additional Projects & Prototypes</h3>
      <p class="section-intro">
        Independent, AI-assisted software demonstrations with public setup and
        validation records. These are separate from the internships and academic
        projects above.
      </p>
      <div class="additional-projects">
        {additional.map((project) => (
          <ProjectEntry project={project} compact />
        ))}
      </div>
    </section>
    <section
      class="portfolio-section portfolio-contact"
      id="professional-contact"
      aria-labelledby="professional-contact-title"
    >
      <h2 id="professional-contact-title">Contact & Professional Links</h2>
      <p>
        For research opportunities or a defined development project, get in
        touch with the question and the output you need.
      </p>
      <EmailLink />
      <div class="actions professional-links">
        <a class="button" href="/contact/">
          Contact →
        </a>
        <a class="text-link" href={site.github}>
          GitHub ↗
        </a>
        <a class="text-link" href={site.linkedin}>
          LinkedIn ↗
        </a>
        <a class="text-link" href={site.cv}>
          Download CV · PDF ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
