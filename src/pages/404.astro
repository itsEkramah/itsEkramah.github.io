---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This address does not point to a page. Return to Muhammad Ekramah's work, services or writing."
  noindex
>
  <div class="wrap">
    <div class="error-page">
      <p class="eyebrow">404 / Page not found</p>
      <h1>A missing page, a way forward.</h1>
      <p class="lede">
        The address may have changed, or the page may not have been published.
        The main sections are a good place to continue.
      </p>
      <div class="actions">
        <a class="button" href="/">
          Back to home →
        </a>
        <a class="text-link" href="/work/">
          Work
        </a>
        <a class="text-link" href="/writing/">
          Writing
        </a>
        <a class="text-link" href="/contact/">
          Contact
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
