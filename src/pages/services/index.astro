---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Services"
  description="Scoped data preparation, research figures, Python development and bioinformatics support. Concrete deliverables, evidence and clear project boundaries."
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Services / Working together</p>
      <h1>Make the next step manageable.</h1>
      <p class="lede">
        For researchers and small teams who need a defined piece of data or
        software work, with readable code and clear deliverables.
      </p>
      <a class="button" href="/contact/">
        Discuss a project →
      </a>
    </header>
    <div class="service-index">
      {services.map((service, i) => (
        <article>
          <p class="eyebrow">0{i + 1} / Service</p>
          <h2>
            <a href={`/services/${service.id}/`}>{service.data.title}</a>
          </h2>
          <p>{service.data.summary}</p>
          <p class="audience">
            For{' '}
            {service.data.audience.charAt(0).toLowerCase() +
              service.data.audience.slice(1)}
          </p>
          <ul>
            {service.data.deliverables.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
          <a class="text-link" href={`/services/${service.id}/`}>
            Scope, evidence & boundaries →
          </a>
        </article>
      ))}
    </div>
    <section class="section background-grid">
      <div>
        <p class="eyebrow">The process</p>
        <h2>A small sample, then a clear scope.</h2>
      </div>
      <div>
        <p>
          Start with your question, an anonymised sample and the output you
          need. We agree on scope and a first milestone, preserve the original
          data, document decisions and review the result together.
        </p>
        <p>
          Research support is limited to transparent methods and accurate
          contributions. Clinical interpretation, guaranteed scientific findings
          and search-ranking promises are outside this scope.
        </p>
        <a class="text-link" href="/contact/">
          Start a conversation →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
